# Frontier (OLCF) environment for WarpX + openPMD-api + ADIOS2 builds/runs.
#
# Usage:
#   export WORKDIR=/lustre/orion/<project>/scratch/<user>/<exp>
#   source bash.setup.env
# Or:
#   source bash.setup.env /lustre/orion/<project>/scratch/<user>/<exp>
#
# WORKDIR is the install/build root created by build.setup (contains binary/).

if [ -n "${1:-}" ]; then
  export WORKDIR="$1"
fi
if [ -z "${WORKDIR:-}" ]; then
  echo "ERROR: set WORKDIR or pass it as: source bash.setup.env /path/to/workdir" >&2
  return 1 2>/dev/null || exit 1
fi

module load emacs
module load cmake/3.30.5
module load craype-accel-amd-gfx90a
module load rocm
module load cray-mpich/8.1.31
module load cce/18.0.1  # must be loaded after rocm

# optional: faster builds
module load ccache
module load ninja

module load hdf5/1.14.5-mpi

#### install prefixes (populated by build.setup) #####
export INSTALL_TOP="${WORKDIR}"
export ADIOS2_DIR="${INSTALL_TOP}/binary/adios/lib64/cmake/adios2"
export openPMD_DIR="${INSTALL_TOP}/binary/openPMD-api/lib64/cmake/openPMD"

# runtime library path for custom installs
if [ -d "${INSTALL_TOP}/binary/adios/lib64" ]; then
  export LD_LIBRARY_PATH="${INSTALL_TOP}/binary/adios/lib64:${LD_LIBRARY_PATH:-}"
fi
if [ -d "${INSTALL_TOP}/binary/openPMD-api/lib64" ]; then
  export LD_LIBRARY_PATH="${INSTALL_TOP}/binary/openPMD-api/lib64:${LD_LIBRARY_PATH:-}"
  export PKG_CONFIG_PATH="${INSTALL_TOP}/binary/openPMD-api/lib64/pkgconfig:${PKG_CONFIG_PATH:-}"
  export CMAKE_PREFIX_PATH="${INSTALL_TOP}/binary/openPMD-api:${CMAKE_PREFIX_PATH:-}"
fi

####### for WarpX GPU compilation (MI250X) #########
export MPICH_GPU_SUPPORT_ENABLED=1
export AMREX_AMD_ARCH=gfx90a

echo "Frontier env ready. WORKDIR=${WORKDIR}"
