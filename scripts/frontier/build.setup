#!/usr/bin/env bash
# Build ADIOS2, openPMD-api, and WarpX on Frontier (OLCF).
#
# Usage:
#   ./build.setup /lustre/orion/<project>/scratch/<user>/<exp>
# Or:
#   WORKDIR=/lustre/orion/<project>/scratch/<user>/<exp> ./build.setup
#
# Prerequisites: source bash.setup.env with the same WORKDIR first, e.g.
#   export WORKDIR=...
#   source bash.setup.env
#   ./build.setup
#
# Layout under WORKDIR:
#   binary/{adios,openPMD-api,warpx}   installs
#   build/{adios,openPMD,warpx}        build trees
#   src/{adios,openPMD,warpx}          clones (created in cwd if run from WORKDIR/src)
#
# Versions used in the paper: WarpX 25.12, ADIOS2 2.11 (adjust tags below if needed).

set -euo pipefail

if [ -n "${1:-}" ]; then
  WORKDIR="$1"
fi
if [ -z "${WORKDIR:-}" ]; then
  echo "Usage: WORKDIR=/path/to/workdir $0" >&2
  echo "   or: $0 /path/to/workdir" >&2
  exit 1
fi

export WORKDIR
export INSTALL_TOP="${WORKDIR}"
NPROC="${NPROC:-8}"

# Paper software targets (override as needed)
ADIOS2_TAG="${ADIOS2_TAG:-v2.11.0}"
WARPX_TAG="${WARPX_TAG:-25.12}"
# openPMD-api: use a recent release compatible with ADIOS2 2.11; override if needed
OPENPMD_TAG="${OPENPMD_TAG:-0.16.1}"

mkdir -p "${INSTALL_TOP}/binary/adios"
mkdir -p "${INSTALL_TOP}/binary/openPMD-api"
mkdir -p "${INSTALL_TOP}/binary/warpx"
mkdir -p "${INSTALL_TOP}/build/adios"
mkdir -p "${INSTALL_TOP}/build/openPMD"
mkdir -p "${INSTALL_TOP}/build/warpx"
mkdir -p "${INSTALL_TOP}/src"
cd "${INSTALL_TOP}/src"

echo "=== Building into WORKDIR=${WORKDIR} ==="

##### ADIOS2 #####
if [ ! -d adios/ADIOS2 ]; then
  mkdir -p adios
  cd adios
  ln -sfn "${INSTALL_TOP}/binary/adios" install
  ln -sfn "${INSTALL_TOP}/build/adios" build
  git clone https://github.com/ornladios/ADIOS2.git
  cd ADIOS2
  git checkout "${ADIOS2_TAG}"
  cd ..
else
  cd adios
fi

# Optional compression modules on Frontier (uncomment if desired):
# module load c-blosc zfp sz zstd

cmake -DADIOS2_USE_Fortran=OFF \
      -DCMAKE_BUILD_TYPE=RelWithDebInfo \
      -DCMAKE_INSTALL_PREFIX="${INSTALL_TOP}/binary/adios" \
      -DADIOS2_USE_HDF5=OFF \
      -B build \
      -S ADIOS2
cmake --build build -j "${NPROC}"
cmake --install build

export ADIOS2_DIR="${INSTALL_TOP}/binary/adios/lib64/cmake/adios2"
export LD_LIBRARY_PATH="${INSTALL_TOP}/binary/adios/lib64:${LD_LIBRARY_PATH:-}"
cd "${INSTALL_TOP}/src"

##### openPMD-api #####
if [ ! -d openPMD/openPMD-api ]; then
  mkdir -p openPMD
  cd openPMD
  ln -sfn "${INSTALL_TOP}/binary/openPMD-api" install
  ln -sfn "${INSTALL_TOP}/build/openPMD" build
  git clone https://github.com/openPMD/openPMD-api.git
  cd openPMD-api
  git checkout "${OPENPMD_TAG}"
  cd ..
else
  cd openPMD
fi

cmake -DopenPMD_USE_PYTHON=OFF \
      -DCMAKE_BUILD_TYPE=RelWithDebInfo \
      -DopenPMD_USE_HDF5=ON \
      -DCMAKE_INSTALL_PREFIX="${INSTALL_TOP}/binary/openPMD-api" \
      -B build \
      -S openPMD-api
cmake --build build -j "${NPROC}"
cmake --install build

export OPENPMD_INSTALL_DIR="${INSTALL_TOP}/binary/openPMD-api"
export openPMD_DIR="${OPENPMD_INSTALL_DIR}/lib64/cmake/openPMD"
export LD_LIBRARY_PATH="${OPENPMD_INSTALL_DIR}/lib64:${LD_LIBRARY_PATH:-}"
export PKG_CONFIG_PATH="${OPENPMD_INSTALL_DIR}/lib64/pkgconfig:${PKG_CONFIG_PATH:-}"
export CMAKE_PREFIX_PATH="${OPENPMD_INSTALL_DIR}:${CMAKE_PREFIX_PATH:-}"
cd "${INSTALL_TOP}/src"

##### WarpX #####
# IMPORTANT: with a custom openPMD, keep WarpX_openpmd_internal=OFF so CMake
# does not download a private copy into _deps/.
if [ ! -d warpx/WarpX ]; then
  mkdir -p warpx
  cd warpx
  ln -sfn "${INSTALL_TOP}/build/warpx" build
  git clone https://github.com/BLAST-WarpX/warpx.git WarpX
  cd WarpX
  git checkout "${WARPX_TAG}"
  cd ..
else
  cd warpx
fi

export AMREX_AMD_ARCH=gfx90a
export MPICH_GPU_SUPPORT_ENABLED=1

cmake -DWarpX_OPENPMD=ON \
      -DWarpX_openpmd_internal=OFF \
      -DWarpX_DIMS="1;2;3;RZ" \
      -DWarpX_COMPUTE=HIP \
      -DCMAKE_BUILD_TYPE=RelWithDebInfo \
      -DCMAKE_INSTALL_PREFIX="${INSTALL_TOP}/binary/warpx" \
      -B build \
      -S WarpX
cmake --build build -j "${NPROC}"
cmake --install build

echo "=== Build finished ==="
echo "Install root: ${INSTALL_TOP}/binary"
echo "Re-source env:  source $(dirname "$0")/bash.setup.env ${WORKDIR}"
